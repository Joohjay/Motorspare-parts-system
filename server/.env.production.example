# JM SPAREPARTS — Production Environment Configuration
#
# Copy this file to server/.env and fill in real values.
# The server will NOT start if placeholder values are detected.

# Node environment: production
NODE_ENV=production

# API port
PORT=4000

# Frontend origin (must use HTTPS in production)
CLIENT_ORIGIN=https://your-domain.com

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://makire:YOUR_STRONG_PASSWORD@localhost:5432/makire_motorparts

# JWT secret — generate with: openssl rand -hex 64
# MUST be at least 32 characters. MUST NOT be a placeholder.
JWT_SECRET=GENERATE_A_REAL_SECRET_HERE

# JWT expiration (default: 8h)
JWT_EXPIRES_IN=8h

# Session cookie name (default: makire_session)
AUTH_COOKIE_NAME=makire_session

# bcrypt cost (10-15, default: 12)
AUTH_BCRYPT_COST=12

# Login rate limiting
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10

# Password reset token TTL (default: 1 hour)
AUTH_RESET_TOKEN_TTL_MS=3600000

# Password reset URL (the frontend reset page)
AUTH_RESET_URL=https://your-domain.com/reset-password
