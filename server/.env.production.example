# MAKIRE MOTORPARTS — production backend environment template.
# Copy the values that apply and DO NOT commit the resulting file.
# The server fails fast at startup if any required value is invalid.

# Environment: development | test | production
NODE_ENV=production

# Public port for the API
PORT=4000

# Deployed frontend origin (must be https://)
CLIENT_ORIGIN=https://app.makire-motorparts.com

# Production PostgreSQL connection string (never commit real credentials)
DATABASE_URL=postgresql://makire:REPLACE_WITH_REAL_PASSWORD@db-host:5432/makire_motorparts_prod

# Unique random value (generate: openssl rand -hex 64)
JWT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
JWT_EXPIRES_IN=8h