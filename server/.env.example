# MAKIRE MOTORPARTS — backend environment configuration.
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# Frontend origin allowed by CORS (must match your deployed frontend URL in production).
# The alias CLIENT_URL is also accepted if CLIENT_ORIGIN is not set.
# Examples:
#   Development: http://localhost:5173
#   Production:  https://app.makire-motorparts.com
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Examples:
#   Local dev:  postgresql://makire:makire@localhost:5432/makire_motorparts
#   Production: postgresql://user:strongpassword@db-host:5432/makire_motorparts_prod
DATABASE_URL=postgresql://makire:makire@localhost:5432/makire_motorparts

# Authentication foundation.
# Generate with: openssl rand -hex 64
# MUST be at least 32 characters. Use a UNIQUE random value in production.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Token/session lifetime (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h

# httpOnly session cookie name (defaults to makire_session)
#AUTH_COOKIE_NAME=makire_session
# Bcrypt cost for password hashing (default 12; 10-15)
#AUTH_BCRYPT_COST=12
# Login brute-force limiter: window in ms and max failed attempts per window
#AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
#AUTH_LOGIN_RATE_LIMIT_MAX=10
# Password reset token lifetime in ms (default 1 hour)
#AUTH_RESET_TOKEN_TTL_MS=3600000
# Base URL used to build password reset links (defaults to CLIENT_ORIGIN/reset-password)
#AUTH_RESET_URL=http://localhost:5173/reset-password