# MAKIRE MOTORPARTS — environment overview
#
# This file documents the environment variables used by the project. It is NOT
# read by the applications themselves. Each package reads its own .env file
# from its own directory:
#
#   server/  ->  server/.env      (see server/.env.example)
#   client/  ->  client/.env      (see client/.env.example)
#
# NEVER commit real .env files. Copy the examples and fill in real values.

# ---------------------------------------------------------------------------
# Server (server/.env)
# ---------------------------------------------------------------------------
# Environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# Frontend origin allowed by CORS (also accepted: CLIENT_URL)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://makire:makire@localhost:5432/makire_motorparts

# Authentication foundation. Generate with: openssl rand -hex 64
# Must be at least 32 characters. Use a UNIQUE random value in production.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Token lifetime (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# Client (client/.env)
# ---------------------------------------------------------------------------
# Base URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:4000/api